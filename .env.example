# AI-ASSISTED: Cursor
# PROMPT: RAYA assistant env example (JARVIS_* still accepted as legacy)
# ACCEPTED-BY: vignesh

LLM_PROVIDER=groq
GROQ_API_KEY=
GROQ_BASE_URL=https://api.groq.com/openai/v1
RAYA_CLOUD_MODE=false
RAYA_AUTH_ENABLED=false
RAYA_ACCESS_PASSWORD=
RAYA_SESSION_SECRET=
RAYA_SESSION_MAX_AGE=604800
GROQ_MODEL=openai/gpt-oss-20b
RAYA_AGENT_ENABLED=true
RAYA_MEMORY_ENABLED=true
RAYA_RAG_ENABLED=true
RAYA_RAG_EMBED_MODEL=all-MiniLM-L6-v2
RAYA_RAG_CHUNK_SIZE=800
RAYA_RAG_CHUNK_OVERLAP=120
RAYA_RAG_TOP_K=5
RAYA_RAG_MIN_SCORE=0.25
RAYA_RAG_EXTRA_PATHS=
RAYA_WEB_SEARCH_MODE=fetch
RAYA_WEB_SEARCH_MAX_RESULTS=3
RAYA_GOOGLE_API_KEY=
RAYA_GOOGLE_CSE_ID=
RAYA_MCP_ENABLED=false
RAYA_MCP_URL=
RAYA_DEBUG=false
RAYA_TTS_PROVIDER=elevenlabs
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=
ELEVENLABS_MODEL=eleven_multilingual_v2
ELEVENLABS_STABILITY=0.45
ELEVENLABS_SIMILARITY=0.75

# API host only (e.g. https://qe-automation.example.com or http://127.0.0.1:8888)
# Do NOT use the UI login URL (/qe_engine/login).
QE_ENGINE_URL=
QE_ENGINE_USERNAME=
QE_ENGINE_PASSWORD=
QE_ENGINE_PROJECT_NAME=
QE_ENGINE_TOKEN=

QE_MCP_AUTOMATION_DIR=/data/QE_Engine/QE_Engine/mcp_automation
QE_PROACTIVE_DIR=/data/QE_Engine/QE_Engine/ProactiveAutomation
QE_ENGINE_UI_DIR=/data/QE_Engine/QE_Engine/qe_engine_ui
QE_MCP_PROXY_URL=http://127.0.0.1:3100/mcp
QE_ENGINE_UI_URL=http://127.0.0.1:3000